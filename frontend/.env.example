# Vite frontend settings. Replace placeholders locally; never commit real values.
VITE_API_TARGET=http://localhost:5000
VITE_COGNITO_DOMAIN=https://your-cognito-domain.auth.ap-southeast-1.amazoncognito.com
VITE_COGNITO_CLIENT_ID=replace-with-spa-client-id
VITE_COGNITO_USER_POOL_ID=ap-southeast-1_REPLACE_ME
VITE_ENABLE_REACT_AUTH_UI=false
# Optional Web Push public key; leave empty when push is not configured.
VITE_VAPID_PUBLIC_KEY=

# Release workflow sets production explicitly and validates public config.
VITE_RELEASE_CHANNEL=dev
VITE_ENABLE_OCR=true
VITE_SELF_SIGN_UP=true
VITE_SUPPORT_EMAIL=homewallet26@gmail.com
