# Public browser configuration only. Every VITE_* value is embedded in the build.
# Copy this file to .env.local. Never add AWS keys or a Cognito client secret.
VITE_COGNITO_AUTHORITY=https://cognito-idp.ap-southeast-1.amazonaws.com/REPLACE_USER_POOL_ID
VITE_COGNITO_DOMAIN=https://REPLACE_DOMAIN.auth.ap-southeast-1.amazoncognito.com
VITE_COGNITO_CLIENT_ID=REPLACE_PUBLIC_APP_CLIENT_ID
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_COGNITO_LOGOUT_URI=http://localhost:5173/
VITE_API_BASE_URL=/api
# Local Vite development proxy only; never an HTTP production API URL.
VITE_DEV_API_TARGET=http://127.0.0.1:5000
