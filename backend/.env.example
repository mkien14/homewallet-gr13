# Local Flask API settings. Replace placeholders locally; never commit secrets.
COGNITO_ISSUER=https://cognito-idp.ap-southeast-1.amazonaws.com/ap-southeast-1_REPLACE_ME
COGNITO_JWKS_URI=https://cognito-idp.ap-southeast-1.amazonaws.com/ap-southeast-1_REPLACE_ME/.well-known/jwks.json
COGNITO_CLIENT_IDS=replace-with-client-id
COGNITO_HOSTED_UI=https://your-cognito-domain.auth.ap-southeast-1.amazoncognito.com

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=homewallet_local
DB_PASSWORD=replace-with-local-only-password
DB_NAME=homewallet

AWS_REGION=ap-southeast-1
S3_BUCKET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
SES_FROM_ADDRESS=

# Optional Redis cache and Web Push configuration.
REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_AUTH_TOKEN=
REDIS_SSL_CA=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_SUB=
